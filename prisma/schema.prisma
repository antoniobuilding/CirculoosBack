generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  VIEWER
}

enum ProductStatus {
  IN_USE
  MANUFACTURING
  REPAIR
  RECYCLING
  DISTRIBUTION
  SECOND_LIFE
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(VIEWER)
  avatar    String?
  actorId   Int?
  actor     Actor?   @relation(fields: [actorId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Product {
  id                 String        @id
  name               String
  material           String
  recycledPercentage Float         @map("recycled_percentage")
  weight             Float
  color              String
  origin             String
  status             ProductStatus
  currentOwner       String        @map("current_owner")
  batch              String
  certifications     String[]
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  events             ProductEvent[]

  @@map("products")
}

model ProductEvent {
  id          Int      @id @default(autoincrement())
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        String
  date        DateTime
  actor       String
  location    String
  description String
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("product_events")
}

model Actor {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  role        String
  location    String
  description String
  metrics     Json
  color       String
  users       User[]

  @@map("actors")
}

model EnvironmentalMetric {
  id      Int    @id @default(autoincrement())
  key     String @unique
  label   String
  current Float
  target  Float
  unit    String
  change  String
  icon    String?

  @@map("environmental_metrics")
}

